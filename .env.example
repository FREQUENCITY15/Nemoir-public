DISCORD_BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
NEMOIR_GUILD_ID=
NEMOIR_INTAKE_CHANNEL_ID=
NEMOIR_ADDITIONAL_INTAKE_CHANNEL_IDS=
NEMOIR_ANEMONE_CATEGORY_ID=
NEMOIR_NURSERY_CHANNEL_ID=
NEMOIR_ADMIN_USER_IDS=
NEMOIR_DATABASE_PATH=data/nemoir.sqlite3
NEMOIR_RUNTIME_DIR=data/runtime
NEMOIR_LOG_LEVEL=INFO
NEMOIR_ALLOW_LIVE_DEEPSEEK=false
NEMOIR_ALLOW_CHANNEL_WRITE=false
NEMOIR_PROMPT_MAX_INPUT_CHARS=2000
NEMOIR_PROMPT_MAX_OUTPUT_TOKENS=1024
# Bounded background autonomous worker: scan interval and max concurrent
# provider requests (one seal can never launch an uncontrolled number of
# paid calls).
NEMOIR_AUTONOMOUS_POLL_SECONDS=3
NEMOIR_AUTONOMOUS_MAX_CONCURRENT=1
